# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/dist

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local
/.nx
/.nx/cache
/.vscode/*
!/.vscode/extensions.json
.idea

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Optional eslint cache
.eslintcache

# Reference files
reference

# Secrets
.env

# Staged by scripts/stage-mobile-public.mjs before the native build.
.mobile-public
# Build output. Both bundles are reproducible from source.
/dist-mobile
/ios
# android/ is committed on purpose: it carries the camera permission and the
# OAuth deep link, and regenerating it per build would drop both.
/android/app/build
/android/build
/android/.gradle
/android/app/src/main/assets/public

# Supabase CLI scratch state: project ref, org id, pooler URL. Machine-local and
# rewritten on every `supabase link`.
supabase/.temp